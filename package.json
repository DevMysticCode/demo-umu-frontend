{
  "name": "umovingu-nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "npx rimraf .nuxt && nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mobile:assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor '#231D45' --splashBackgroundColor '#FFFFFF'",
    "mobile:sync": "npm run generate && cap sync",
    "mobile:sync:ios": "npm run generate && cap sync ios",
    "mobile:sync:android": "npm run generate && cap sync android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:build:bundled": "cross-env CAPACITOR_BUILD=true nuxt generate && cap sync",
    "mobile:build:bundled:ios": "cross-env CAPACITOR_BUILD=true nuxt generate && cap sync ios",
    "mobile:build:bundled:android": "cross-env CAPACITOR_BUILD=true nuxt generate && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@nuxt/ui": "^2.18.7",
    "@pinia/nuxt": "^0.5.5",
    "@stripe/stripe-js": "^8.11.0",
    "mapbox-gl": "^3.20.0",
    "nuxt": "^3.13.0",
    "pinia": "^2.2.4",
    "qrcode": "^1.5.4",
    "vue": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@nuxt/devtools": "^1.5.2",
    "@nuxt/typescript-build": "^3.0.2",
    "@tailwindcss/typography": "^0.5.15",
    "cross-env": "^10.1.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.2"
  }
}
