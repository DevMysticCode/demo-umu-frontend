{
  "name": "umovingu-nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "nuxt build",
    "dev": "npx rimraf .nuxt && nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "patch-package && nuxt prepare",
    "mobile:assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor '#231D45' --splashBackgroundColor '#FFFFFF'",
    "mobile:sync": "npm run generate && cap sync",
    "mobile:sync:ios": "npm run generate && cap sync ios",
    "mobile:sync:android": "npm run generate && cap sync android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:build:bundled": "cross-env CAPACITOR_BUILD=true CAPACITOR_USE_REMOTE=false nuxt generate && cross-env CAPACITOR_USE_REMOTE=false cap sync",
    "mobile:build:bundled:ios": "cross-env CAPACITOR_BUILD=true CAPACITOR_USE_REMOTE=false nuxt generate && cross-env CAPACITOR_USE_REMOTE=false cap sync ios",
    "mobile:build:bundled:android": "cross-env CAPACITOR_BUILD=true CAPACITOR_USE_REMOTE=false nuxt generate && cross-env CAPACITOR_USE_REMOTE=false cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-document-scanner": "^8.4.2",
    "@nuxt/ui": "^2.22.3",
    "entities": "^7.0.1",
    "estree-walker": "^2.0.2",
    "@pinia/nuxt": "^1.0.3",
    "@stripe/stripe-js": "^8.11.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.20.0",
    "nuxt": "^4.6.4",
    "nuxt-security": "2.5.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@nuxt/devtools": "^1.5.2",
    "@nuxt/typescript-build": "^3.0.2",
    "@tailwindcss/typography": "^0.5.15",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.23",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
