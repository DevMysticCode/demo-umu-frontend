default_platform(:ios)

# Everything here reads from CI env vars / GitHub Secrets rather than
# hardcoding the client's Apple account details — switching from NCS's
# account to UmovingU's is then just updating the GitHub Secrets, no
# code change. See .github/workflows/ios-testflight.yml for how these
# are set.
platform :ios do
  desc "Build the already-synced Capacitor iOS project and upload to TestFlight"
  lane :testflight do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false,
    )

    # Automatic signing: Xcode (via the API key above) creates/reuses
    # whatever distribution certificate + provisioning profile this
    # Apple Developer team needs — no manually-generated .p12/profile
    # to store as a secret. Requires the API key to have at least
    # "App Manager" access (same role the deployment team's key already
    # has) so it can read/write Certificates, Identifiers & Profiles.
    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      path: "ios/App/App.xcodeproj",
    )

    # Capacitor 8's iOS template uses Swift Package Manager (the
    # CapApp-SPM folder), not CocoaPods — there is no Podfile and no
    # App.xcworkspace, only App.xcodeproj. Xcode resolves the SPM
    # dependencies itself during the build.
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
      },
      # update_code_signing_settings only flips the project file to
      # "Automatic" - it doesn't create the actual certificate/
      # provisioning profile. -allowProvisioningUpdates lets xcodebuild
      # create/update those itself (first build under a bundle id has
      # neither yet) - but xcodebuild's own provisioning step doesn't
      # automatically pick up the app_store_connect_api_key set above;
      # it needs the same key handed to it directly, or it falls back to
      # wanting an actual Xcode-signed-in Apple ID ("No Accounts: Add a
      # new account in Accounts settings").
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ENV.fetch('ASC_KEY_FILEPATH')}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" "),
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end
end
