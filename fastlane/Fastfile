default_platform(:ios)

# Everything here reads from CI env vars / GitHub Secrets rather than
# hardcoding the client's Apple account details — switching from NCS's
# account to UmovingU's is then just updating the GitHub Secrets, no
# code change. See .github/workflows/ios-testflight.yml for how these
# are set.
platform :ios do
  desc "Build the already-synced Capacitor iOS project and upload to TestFlight"
  lane :testflight do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false,
    )

    app_identifier = ENV.fetch("CAPACITOR_APP_ID", "io.umovingu")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # xcodebuild's own "Automatic" signing could not be made to resolve
    # a Distribution profile in this headless CI context - every attempt
    # (forcing the identity, removing it, scoping to Release only) still
    # had Xcode independently decide "development" and then either ask
    # for device UDIDs or reject the manual override as conflicting.
    # Requesting the actual App Store certificate + profile explicitly
    # via the API and signing manually sidesteps that resolution
    # entirely - "appstore" is passed directly, nothing to infer.
    get_certificates(
      development: false,
      team_id: team_id,
    )

    # No "type:" option here - App Store is the default when none of
    # adhoc/developer_id/development are set to true.
    get_provisioning_profile(
      app_identifier: app_identifier,
      team_id: team_id,
      filename: "AppStore.mobileprovision",
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: team_id,
      path: "ios/App/App.xcodeproj",
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    # Capacitor 8's iOS template uses Swift Package Manager (the
    # CapApp-SPM folder), not CocoaPods — there is no Podfile and no
    # App.xcworkspace, only App.xcodeproj. Xcode resolves the SPM
    # dependencies itself during the build.
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          app_identifier => profile_name,
        },
      },
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end
end
