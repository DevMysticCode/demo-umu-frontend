default_platform(:ios)

# Everything here reads from CI env vars / GitHub Secrets rather than
# hardcoding the client's Apple account details — switching from NCS's
# account to UmovingU's is then just updating the GitHub Secrets, no
# code change. See .github/workflows/ios-testflight.yml for how these
# are set.
platform :ios do
  desc "Read-only: list this team's distribution certificates"
  lane :list_certs do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false,
    )
    certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
    certs.each do |c|
      UI.important("CERT #{c.inspect}")
    end
    UI.important("Total: #{certs.length}")
  end

  desc "Build the already-synced Capacitor iOS project and upload to TestFlight"
  lane :testflight do
    # Without this, importing a certificate into the runner's default
    # login keychain leaves codesign without non-interactive access to
    # the private key - it then blocks forever waiting for a
    # keychain-access prompt that can never appear in CI (confirmed: an
    # earlier run hung for over an hour at "Signing Cordova.framework").
    # setup_ci creates a temporary keychain with explicit codesign
    # access and no prompts.
    setup_ci

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false,
    )

    app_identifier = ENV.fetch("CAPACITOR_APP_ID", "io.umovingu")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # xcodebuild's own "Automatic" signing could never be made to
    # resolve a Distribution profile in this headless CI context, and
    # a prior approach (get_certificates fresh every run, in a
    # keychain thrown away at the end of the job) silently orphaned a
    # new certificate on every run until Apple's per-team cert limit
    # was hit. match stores the cert/key/profile encrypted on a
    # dedicated branch of this same repo and reuses them run after
    # run - nothing is created unless genuinely missing or expired.
    match(
      type: "appstore",
      app_identifier: app_identifier,
      team_id: team_id,
      git_url: "https://x-access-token:#{ENV.fetch('GITHUB_TOKEN')}@github.com/OpenProperty-umu/umu-mobile-webapp.git",
      git_branch: "ios-certs",
      readonly: false,
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: team_id,
      path: "ios/App/App.xcodeproj",
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
    )

    # Capacitor 8's iOS template uses Swift Package Manager (the
    # CapApp-SPM folder), not CocoaPods — there is no Podfile and no
    # App.xcworkspace, only App.xcodeproj. Xcode resolves the SPM
    # dependencies itself during the build.
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          app_identifier => lane_context[SharedValues::SIGH_NAME],
        },
      },
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end
end
